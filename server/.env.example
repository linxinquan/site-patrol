# ============================================================
# 服务端配置模板（浩辰云图 CAD + 和风天气 + 腾讯云 COS）
# ============================================================
# 用法（二选一）：
#   1) 复制本文件为 server/config.py，填入真实值后保存
#   2) 或设置同名环境变量（代码通过 os.environ.get 读取，环境变量优先）
#
# 说明：
#   - 真实凭证文件 server/config.py / server/cos_config.py 已被 .gitignore 排除，不会入库
#   - 未配置凭证时服务仍可启动：CAD 转换返回 mock、天气接口返回 mock，保证前端可渲染
#   - 如需真实 CAD 转换 / 真实天气，请到对应平台注册后填入下面的值
# ============================================================

# ---- 浩辰云图 CAD（华为云市场）----
# 提交转换等接口用的网关地址
GCAD_API_GATEWAY=https://2dviewer.apistore.huaweicloud.com
# 华为云 APIG 市场 AppCode（X-Apig-AppCode）
GCAD_APP_CODE=YOUR_APP_CODE
# 可选：Bearer Token（与 AppCode 二选一，通常用 AppCode 即可）
GCAD_API_TOKEN=
# AK/SK 签名密钥（getTaskStatus 走 gstarcadsdk 网关时使用）
GCAD_APP_KEY=YOUR_APP_KEY
GCAD_APP_SECRET=YOUR_APP_SECRET
# OCF 缓存目录（相对 server/ 目录，默认 ./ocf_cache）
GCAD_OCF_DIR=./ocf_cache
# 转换任务轮询间隔（秒，默认 2）
GCAD_POLL_INTERVAL=2
# 转换任务轮询超时（秒，默认 180）
GCAD_POLL_TIMEOUT=180

# ---- 服务端口（默认 8800）----
CAD_SERVER_PORT=8800

# ---- 和风天气（QWeather）免费 API ----
# 个人开发版（免费 1000 次/天）：https://dev.qweather.com 注册获取 Key。
# 留空时 /api/weather 返回 mock 数据（保证前端可正常渲染）。
QWEATHER_KEY=YOUR_QWEATHER_KEY
# 专属 API Host：和风天气自 2026 年起强制使用开发者专属域名（格式 xxx.qweatherapi.com）。
# 在控制台「设置」页获取；留空时回退到公共域名 devapi.qweather.com。
QWEATHER_HOST=YOUR_QWEATHER_HOST

# ---- 腾讯云 COS（可选，仅 DWG 上传/转换需要）----
# 不配置时 CAD 转换仍可用 fileBase64 方式，但走 fileUrl 方式会失败。
COS_BUCKET=YOUR_BUCKET
COS_REGION=ap-guangzhou
COS_SECRET_ID=YOUR_SECRET_ID
COS_SECRET_KEY=YOUR_SECRET_KEY
